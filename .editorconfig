root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,ps1,manifest}]
end_of_line = crlf

[*.{sh,py,swift,json,yml,yaml,md}]
end_of_line = lf
